---
import { datasets } from "../config/datasets";
---

<aside class="panel sidebar">
    <p class="panel-title">Buscar Lugar</p>

    <div class="form-group">
        <label for="location-search">Distrito / Provincia / Departamento</label>
        <div class="combobox-container">
            <input
                type="text"
                id="location-search"
                placeholder="Ej. Trujillo, Miraflores…"
                autocomplete="off"
            />
            <ul id="location-results" class="dropdown-list hidden"></ul>
        </div>
        <div style="display:flex; gap:.4rem; margin-top:.5rem;">
            <button id="btn-reset" class="btn btn-secondary btn-full">
                🗺 Vista Nacional
            </button>
        </div>
    </div>

    <hr class="panel-divider" />

    <p class="panel-title">Capas de Servicios</p>
    <p
        class="text-muted"
        style="font-size:.8rem; margin-bottom:.75rem; line-height:1.5;"
    >
        Activa las capas y haz clic en un Centro Poblado para calcular su
        accesibilidad.
    </p>

    <div id="dataset-checkboxes">
        {
            datasets.map((ds) => (
                <label class="layer-item" data-id={ds.id}>
                    <input
                        type="checkbox"
                        value={ds.id}
                        data-url={ds.url}
                        data-name={ds.name}
                        data-format={ds.format}
                        data-geometry={ds.geometryType}
                        data-color={ds.color}
                        data-name-field={ds.nameField}
                    />
                    <span class="layer-dot" style={`background:${ds.color}`} />
                    <span class="layer-name">{ds.name}</span>
                </label>
            ))
        }
    </div>

    <hr class="panel-divider" />

    <p class="panel-title">Umbral de Carencia</p>
    <p
        class="text-muted"
        style="font-size:.8rem; margin-bottom:.5rem; line-height:1.5;"
    >
        Distancia máxima en km para considerar que un servicio es accesible.
    </p>
    <div class="threshold-group" id="threshold-group">
        <button class="threshold-btn" data-km="2">2 km</button>
        <button class="threshold-btn active" data-km="5">5 km</button>
        <button class="threshold-btn" data-km="10">10 km</button>
    </div>

    <hr class="panel-divider" />

    <button id="btn-scan" class="btn btn-accent btn-full" style="display:none;">
        🔍 Escanear Triple Carencia
    </button>
    <p
        id="scan-hint"
        class="text-muted"
        style="font-size:.75rem; line-height:1.5; margin-top:.5rem;"
    >
        Activa las tres capas de servicios para habilitar el escaneo de zonas
        con triple carencia.
    </p>
</aside>

<script>
    import type {
        DatasetEventDetail,
        LocationEventDetail,
        ActiveDataset,
    } from "../types";

    /* ── Checkboxes → datasetChanged ───────────────────────────────── */
    const checkboxes = document.querySelectorAll<HTMLInputElement>(
        '#dataset-checkboxes input[type="checkbox"]',
    );

    function buildActiveDatasets(): ActiveDataset[] {
        const out: ActiveDataset[] = [];
        checkboxes.forEach((input) => {
            if (input.checked) {
                out.push({
                    id: input.value,
                    url: input.getAttribute("data-url") || "",
                    name: input.getAttribute("data-name") || "",
                    format: input.getAttribute("data-format") as
                        | "geojson"
                        | "shapefile",
                    geometryType: input.getAttribute("data-geometry") as
                        | "fill"
                        | "circle"
                        | "line",
                    color: input.getAttribute("data-color") || "#000",
                    nameField:
                        input.getAttribute("data-name-field") || "nombre",
                });
            }
            // Visual active state on parent label
            const label = input.closest(".layer-item") as HTMLElement;
            if (label) label.classList.toggle("active", input.checked);
        });
        return out;
    }

    function updateDatasets() {
        const activeDatasets = buildActiveDatasets();
        window.dispatchEvent(
            new CustomEvent<DatasetEventDetail>("datasetChanged", {
                detail: { activeDatasets },
            }),
        );
        updateScanButton(activeDatasets);
    }

    checkboxes.forEach((cb) => cb.addEventListener("change", updateDatasets));

    /* ── Scan button visibility ─────────────────────────────────────── */
    const btnScan = document.getElementById("btn-scan") as HTMLButtonElement;
    const scanHint = document.getElementById(
        "scan-hint",
    ) as HTMLParagraphElement;
    const SERVICE_IDS = ["salud", "educacion", "comisarias"];

    function updateScanButton(active: ActiveDataset[]) {
        const activeIds = active.map((d) => d.id);
        const hasCPs = activeIds.includes("centros-poblados");
        const hasServices = SERVICE_IDS.every((id) => activeIds.includes(id));
        const canScan = hasCPs && hasServices;
        btnScan.style.display = canScan ? "flex" : "none";
        scanHint.style.display = canScan ? "none" : "block";
    }

    btnScan.addEventListener("click", () => {
        window.dispatchEvent(
            new CustomEvent("scanTripleCarencia", {
                detail: { thresholdKm: currentThreshold },
            }),
        );
    });

    /* ── Threshold selector ─────────────────────────────────────────── */
    let currentThreshold = 5;
    const thresholdBtns =
        document.querySelectorAll<HTMLButtonElement>(".threshold-btn");

    thresholdBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            thresholdBtns.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            currentThreshold = parseInt(btn.dataset.km || "5");
            window.dispatchEvent(
                new CustomEvent("thresholdChanged", {
                    detail: { thresholdKm: currentThreshold },
                }),
            );
        });
    });

    /* ── Location search via Nominatim ──────────────────────────────── */
    const searchInput = document.getElementById(
        "location-search",
    ) as HTMLInputElement;
    const resultsList = document.getElementById(
        "location-results",
    ) as HTMLUListElement;
    const btnReset = document.getElementById("btn-reset") as HTMLButtonElement;

    let searchTimeout: ReturnType<typeof setTimeout>;

    searchInput.addEventListener("input", () => {
        clearTimeout(searchTimeout);
        const query = searchInput.value.trim();

        if (!query || query.length < 3) {
            resultsList.innerHTML = "";
            resultsList.classList.add("hidden");
            return;
        }

        searchTimeout = setTimeout(async () => {
            try {
                const params = new URLSearchParams({
                    q: `${query}, Perú`,
                    format: "json",
                    limit: "7",
                    countrycodes: "pe",
                    "accept-language": "es",
                });
                const res = await fetch(
                    `https://nominatim.openstreetmap.org/search?${params}`,
                    {
                        headers: {
                            "User-Agent": "GeoTon-AccessibilityApp/1.0",
                        },
                    },
                );
                const results = await res.json();

                resultsList.innerHTML = "";
                if (!results.length) {
                    resultsList.classList.add("hidden");
                    return;
                }

                results.forEach((loc: any) => {
                    const li = document.createElement("li");
                    const shortName = loc.display_name.split(",")[0];
                    const typeLabel = loc.type ?? loc.addresstype ?? "lugar";
                    li.innerHTML = `<span>${shortName}</span><span class="loc-type">${typeLabel}</span>`;
                    li.addEventListener("click", () => {
                        searchInput.value = shortName;
                        resultsList.classList.add("hidden");
                        window.dispatchEvent(
                            new CustomEvent<LocationEventDetail>(
                                "locationChanged",
                                {
                                    detail: {
                                        lat: parseFloat(loc.lat),
                                        lng: parseFloat(loc.lon),
                                        zoom: 10,
                                        name: shortName,
                                        level: typeLabel,
                                    },
                                },
                            ),
                        );
                    });
                    resultsList.appendChild(li);
                });

                resultsList.classList.remove("hidden");
            } catch {
                resultsList.classList.add("hidden");
            }
        }, 350);
    });

    document.addEventListener("click", (e) => {
        if (
            !searchInput.contains(e.target as Node) &&
            !resultsList.contains(e.target as Node)
        ) {
            resultsList.classList.add("hidden");
        }
    });

    btnReset.addEventListener("click", () => {
        searchInput.value = "";
        window.dispatchEvent(
            new CustomEvent<LocationEventDetail>("locationChanged", {
                detail: {
                    lat: -9.19,
                    lng: -75.0152,
                    zoom: 5,
                    name: "Perú",
                    level: "Nacional",
                },
            }),
        );
    });
</script>
