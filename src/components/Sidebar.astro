---
import { datasets } from "../config/datasets";
---

<aside class="panel sidebar">
    <h2>Filters</h2>

    <div class="form-group">
        <label for="dataset-select">Select Dataset</label>
        <select id="dataset-select">
            <option value="">-- None --</option>
            {
                datasets.map((ds) => (
                    <option value={ds.id} data-url={ds.clientUrl}>
                        {ds.name}
                    </option>
                ))
            }
        </select>
    </div>

    <div class="form-group">
        <label for="region-select">Region (Departamento)</label>
        <select id="region-select">
            <option value="">National (All Perú)</option>
            <option value="-12.0464,-77.0428,10">Lima</option>
            <option value="-8.1091,-79.0215,10">La Libertad</option>
            <option value="-13.5320,-71.9675,10">Cusco</option>
        </select>
    </div>
</aside>

<script>
    import type { DatasetEventDetail, LocationEventDetail } from "../types";

    const datasetSelect = document.getElementById(
        "dataset-select",
    ) as HTMLSelectElement;
    const regionSelect = document.getElementById(
        "region-select",
    ) as HTMLSelectElement;

    datasetSelect.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        const selectedOption = target.options[target.selectedIndex];

        const detail: DatasetEventDetail = {
            id: target.value,
            url: selectedOption.getAttribute("data-url") || "",
            name: selectedOption.text,
        };

        window.dispatchEvent(new CustomEvent("datasetChanged", { detail }));
    });

    regionSelect.addEventListener("change", (e) => {
        const target = e.target as HTMLSelectElement;
        const val = target.value;
        const regionName = target.options[target.selectedIndex].text;

        let detail: LocationEventDetail;

        if (val) {
            const [lat, lng, zoom] = val.split(",").map(Number);
            detail = { lat, lng, zoom, name: regionName, level: "Region" };
        } else {
            detail = {
                lat: -9.19,
                lng: -75.0152,
                zoom: 5,
                name: "Perú",
                level: "National",
            };
        }

        window.dispatchEvent(new CustomEvent("locationChanged", { detail }));
    });
</script>
