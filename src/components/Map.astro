<div id="map" class="map-container">
    <div id="map-loader" class="map-loader hidden">Cargando datos...</div>
</div>

<script>
    import maplibregl from "maplibre-gl";
    import shp from "shpjs";
    import * as turf from "@turf/turf";
    import type {
        DatasetEventDetail,
        LocationEventDetail,
        AccessibilityStats,
        ActiveDataset,
    } from "../types";

    const map = new maplibregl.Map({
        container: "map",
        style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        center: [-75.0152, -9.19],
        zoom: 5,
    });

    let activeLayerIds: string[] = [];
    let currentActiveDatasets: ActiveDataset[] = []; // Guardamos la config actual
    const loader = document.getElementById("map-loader") as HTMLDivElement;
    const geojsonCache = new Map<string, any>();

    map.on("load", () => {
        // Capa para el radio de 5km y líneas de conexión
        map.addSource("analysis-source", {
            type: "geojson",
            data: { type: "FeatureCollection", features: [] },
        });

        // Polígono del radio (5km)
        map.addLayer({
            id: "analysis-radius",
            type: "fill",
            source: "analysis-source",
            filter: ["==", "$type", "Polygon"],
            paint: {
                "fill-color": "#f39c12",
                "fill-opacity": 0.15,
                "fill-outline-color": "#e67e22",
            },
        });

        // Líneas punteadas hacia los servicios
        map.addLayer({
            id: "analysis-lines",
            type: "line",
            source: "analysis-source",
            filter: ["==", "$type", "LineString"],
            paint: {
                "line-color": ["get", "color"], // Toma el color de las propiedades del GeoJSON
                "line-width": 2,
                "line-dasharray": [2, 2],
            },
        });

        // Capa de resaltado del Centro Poblado
        map.addSource("highlight-source", {
            type: "geojson",
            data: { type: "FeatureCollection", features: [] },
        });
        map.addLayer({
            id: "highlight-circle",
            type: "circle",
            source: "highlight-source",
            paint: {
                "circle-radius": 8,
                "circle-color": "#f1c40f",
                "circle-stroke-width": 2,
                "circle-stroke-color": "#000",
            },
        });
    });

    window.addEventListener(
        "datasetChanged",
        async (e: CustomEvent<DatasetEventDetail>) => {
            currentActiveDatasets = e.detail.activeDatasets;
            const newLayerIds = currentActiveDatasets.map(
                (ds) => `layer-${ds.id}`,
            );

            // Limpiar capas inactivas
            activeLayerIds.forEach((id) => {
                if (!newLayerIds.includes(id)) {
                    if (map.getLayer(id)) map.removeLayer(id);
                    const sourceId = id.replace("layer-", "source-");
                    if (map.getSource(sourceId)) map.removeSource(sourceId);
                    geojsonCache.delete(id.replace("layer-", ""));
                }
            });

            // Limpiar análisis previo si se cambian las capas
            (
                map.getSource("analysis-source") as maplibregl.GeoJSONSource
            )?.setData({ type: "FeatureCollection", features: [] });

            for (const ds of currentActiveDatasets) {
                const sourceId = `source-${ds.id}`;
                const layerId = `layer-${ds.id}`;

                if (!map.getSource(sourceId)) {
                    loader.classList.remove("hidden");
                    try {
                        let geojsonData: any;
                        if (ds.format === "shapefile") {
                            geojsonData = await shp(ds.url);
                        } else if (ds.format === "geojson") {
                            const response = await fetch(ds.url);
                            geojsonData = await response.json();
                        }

                        geojsonCache.set(ds.id, geojsonData);
                        map.addSource(sourceId, {
                            type: "geojson",
                            data: geojsonData,
                        });

                        map.addLayer({
                            id: layerId,
                            type: ds.geometryType,
                            source: sourceId,
                            paint: {
                                "circle-color": ds.color,
                                "circle-radius":
                                    ds.id === "centros-poblados" ? 5 : 4,
                                "circle-stroke-width": 1,
                                "circle-stroke-color": "#ffffff",
                            },
                        });

                        // LÓGICA AL HACER CLIC EN UN CENTRO POBLADO
                        if (ds.id === "centros-poblados") {
                            map.on("click", layerId, (e) => {
                                if (!e.features || e.features.length === 0)
                                    return;
                                const feature = e.features[0];

                                // Resaltar CP
                                (
                                    map.getSource(
                                        "highlight-source",
                                    ) as maplibregl.GeoJSONSource
                                ).setData(feature.geometry);

                                // Extraer coordenadas de forma segura (Point, MultiPoint o GeometryCollection)
                                let coordinates: any;
                                const geom = feature.geometry;
                                if (geom.type === "Point") {
                                    coordinates = (geom as any).coordinates;
                                } else if (geom.type === "MultiPoint") {
                                    coordinates = (geom as any).coordinates[0];
                                } else if (geom.type === "GeometryCollection") {
                                    const coll = geom as any;
                                    const firstPoint = coll.geometries?.find(
                                        (g: any) => g.type === "Point",
                                    );
                                    coordinates = firstPoint?.coordinates;
                                }
                                if (!coordinates) return;

                                const targetPoint = turf.point(
                                    coordinates as [number, number],
                                );
                                const analysisFeatures: any[] = [];

                                // 1. Dibujar Radio de 5km
                                const radiusPoly = turf.circle(targetPoint, 5, {
                                    units: "kilometers",
                                });
                                analysisFeatures.push(radiusPoly);

                                // 2. Función para calcular servicio más cercano y crear línea
                                const calcNearest = (datasetId: string) => {
                                    const config = currentActiveDatasets.find(
                                        (d) => d.id === datasetId,
                                    );
                                    if (!config) return null; // Capa no está activa

                                    const data = geojsonCache.get(datasetId);
                                    if (
                                        !data ||
                                        !data.features ||
                                        data.features.length === 0
                                    )
                                        return null;

                                    const nearest = turf.nearestPoint(
                                        targetPoint,
                                        data,
                                    );
                                    const distance = turf.distance(
                                        targetPoint,
                                        nearest,
                                        { units: "kilometers" },
                                    );

                                    // USO DEL DICCIONARIO ESCALABLE (nameField)
                                    const name =
                                        nearest.properties?.[
                                            config.nameField
                                        ] || "Desconocido";

                                    // Crear línea desde CP hasta el servicio
                                    const line = turf.lineString(
                                        [
                                            targetPoint.geometry.coordinates,
                                            nearest.geometry.coordinates,
                                        ],
                                        { color: config.color }, // Pasamos el color para pintarlo dinámicamente
                                    );
                                    analysisFeatures.push(line);

                                    return { distance, name };
                                };

                                const salud = calcNearest("salud");
                                const educacion = calcNearest("educacion");
                                const comisaria = calcNearest("comisarias");

                                const cpConfig = currentActiveDatasets.find(
                                    (d) => d.id === "centros-poblados",
                                );
                                const cpName =
                                    feature.properties?.[
                                        cpConfig?.nameField || "nombre"
                                    ] || "Centro Poblado";

                                const tripleCarencia =
                                    salud?.distance > 5 &&
                                    educacion?.distance > 5 &&
                                    comisaria?.distance > 5;

                                // 3. Actualizar mapa con el radio y las líneas
                                const fc =
                                    turf.featureCollection(analysisFeatures);
                                (
                                    map.getSource(
                                        "analysis-source",
                                    ) as maplibregl.GeoJSONSource
                                ).setData(fc);

                                // ZOOM AUTOMÁTICO (FitBounds)
                                const bbox = turf.bbox(fc);
                                map.fitBounds(
                                    bbox as [number, number, number, number],
                                    {
                                        padding: 60, // Margen en píxeles
                                        maxZoom: 14, // Evitar zoom excesivo si todo está muy cerca
                                        duration: 1500, // Animación suave
                                    },
                                );

                                // Enviar datos al panel
                                window.dispatchEvent(
                                    new CustomEvent<AccessibilityStats>(
                                        "accessibilityCalculated",
                                        {
                                            detail: {
                                                centroPoblado: cpName,
                                                salud,
                                                educacion,
                                                comisaria,
                                                tripleCarencia,
                                            },
                                        },
                                    ),
                                );
                            });

                            map.on("mouseenter", layerId, () => {
                                map.getCanvas().style.cursor = "pointer";
                            });
                            map.on("mouseleave", layerId, () => {
                                map.getCanvas().style.cursor = "";
                            });
                        }
                    } catch (error) {
                        console.error(
                            `Error loading dataset ${ds.name}:`,
                            error,
                        );
                    } finally {
                        loader.classList.add("hidden");
                    }
                }
            }
            activeLayerIds = newLayerIds;
        },
    );

    window.addEventListener(
        "locationChanged",
        (e: CustomEvent<LocationEventDetail>) => {
            const { lat, lng, zoom } = e.detail;
            map.flyTo({ center: [lng, lat], zoom: zoom, essential: true });
        },
    );
</script>
