<div id="map" class="map-container">
    <div id="map-loader" class="map-loader hidden">Cargando datos...</div>
</div>

<script>
    import maplibregl from "maplibre-gl";
    import shp from "shpjs";
    import * as turf from "@turf/turf";
    import type {
        DatasetEventDetail,
        LocationEventDetail,
        AccessibilityStats,
    } from "../types";

    const map = new maplibregl.Map({
        container: "map",
        style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        center: [-75.0152, -9.19],
        zoom: 5,
    });

    let activeLayerIds: string[] = [];
    const loader = document.getElementById("map-loader") as HTMLDivElement;

    // Caché de GeoJSON para Turf.js
    const geojsonCache = new Map<string, any>();

    // Configurar capa de resaltado
    map.on("load", () => {
        map.addSource("highlight-source", {
            type: "geojson",
            data: { type: "FeatureCollection", features: [] },
        });
        map.addLayer({
            id: "highlight-circle",
            type: "circle",
            source: "highlight-source",
            paint: {
                "circle-radius": 10,
                "circle-color": "transparent",
                "circle-stroke-width": 3,
                "circle-stroke-color": "#f1c40f",
            },
        });
    });

    window.addEventListener(
        "datasetChanged",
        async (e: CustomEvent<DatasetEventDetail>) => {
            const newDatasets = e.detail.activeDatasets;
            const newLayerIds = newDatasets.map((ds) => `layer-${ds.id}`);

            // Remover capas inactivas
            activeLayerIds.forEach((id) => {
                if (!newLayerIds.includes(id)) {
                    if (map.getLayer(id)) map.removeLayer(id);
                    const sourceId = id.replace("layer-", "source-");
                    if (map.getSource(sourceId)) map.removeSource(sourceId);
                    const rawId = id.replace("layer-", "");
                    geojsonCache.delete(rawId);
                }
            });

            // Añadir nuevas capas
            for (const ds of newDatasets) {
                const sourceId = `source-${ds.id}`;
                const layerId = `layer-${ds.id}`;

                if (!map.getSource(sourceId)) {
                    loader.classList.remove("hidden");
                    try {
                        let geojsonData: any;
                        if (ds.format === "shapefile") {
                            geojsonData = await shp(ds.url);
                        } else if (ds.format === "geojson") {
                            const response = await fetch(ds.url);
                            geojsonData = await response.json();
                        }

                        // Guardar en caché para análisis espacial
                        geojsonCache.set(ds.id, geojsonData);

                        map.addSource(sourceId, {
                            type: "geojson",
                            data: geojsonData,
                        });

                        let paintStyle = {};
                        if (ds.geometryType === "circle") {
                            // Hacemos los centros poblados un poco más grandes
                            const radius = ds.id === "centros-poblados" ? 6 : 4;
                            paintStyle = {
                                "circle-color": ds.color,
                                "circle-radius": radius,
                                "circle-stroke-width": 1,
                                "circle-stroke-color": "#ffffff",
                            };
                        } else if (ds.geometryType === "line") {
                            paintStyle = {
                                "line-color": ds.color,
                                "line-width": 2,
                            };
                        }

                        map.addLayer({
                            id: layerId,
                            type: ds.geometryType,
                            source: sourceId,
                            paint: paintStyle,
                        });

                        // Interacción: Clic en Centro Poblado
                        if (ds.id === "centros-poblados") {
                            map.on("click", layerId, (e) => {
                                if (!e.features || e.features.length === 0)
                                    return;
                                const feature = e.features[0];

                                // Resaltar en el mapa
                                const source = map.getSource(
                                    "highlight-source",
                                ) as maplibregl.GeoJSONSource;
                                source.setData(feature.geometry);

                                // CALCULAR ACCESIBILIDAD CON TURF
                                const targetPoint = turf.point([
                                    e.lngLat.lng,
                                    e.lngLat.lat,
                                ]);

                                const calcNearest = (datasetId: string) => {
                                    const data = geojsonCache.get(datasetId);
                                    if (
                                        !data ||
                                        !data.features ||
                                        data.features.length === 0
                                    )
                                        return null;
                                    const nearest = turf.nearestPoint(
                                        targetPoint,
                                        data,
                                    );
                                    const distance = turf.distance(
                                        targetPoint,
                                        nearest,
                                        { units: "kilometers" },
                                    );
                                    return {
                                        distance,
                                        name:
                                            nearest.properties?.nombre ||
                                            nearest.properties?.name ||
                                            "Desconocido",
                                    };
                                };

                                const salud = calcNearest("salud");
                                const educacion = calcNearest("educacion");
                                const comisaria = calcNearest("comisarias");

                                // Definimos Triple Carencia si los 3 servicios están a más de 5km (puedes ajustar este umbral)
                                const umbralKm = 5;
                                const tripleCarencia =
                                    salud?.distance > umbralKm &&
                                    educacion?.distance > umbralKm &&
                                    comisaria?.distance > umbralKm;

                                window.dispatchEvent(
                                    new CustomEvent<AccessibilityStats>(
                                        "accessibilityCalculated",
                                        {
                                            detail: {
                                                centroPoblado:
                                                    feature.properties
                                                        ?.nombre ||
                                                    "Centro Poblado Seleccionado",
                                                salud,
                                                educacion,
                                                comisaria,
                                                tripleCarencia,
                                            },
                                        },
                                    ),
                                );
                            });

                            map.on("mouseenter", layerId, () => {
                                map.getCanvas().style.cursor = "pointer";
                            });
                            map.on("mouseleave", layerId, () => {
                                map.getCanvas().style.cursor = "";
                            });
                        }
                    } catch (error) {
                        console.error(
                            `Error loading dataset ${ds.name}:`,
                            error,
                        );
                    } finally {
                        loader.classList.add("hidden");
                    }
                }
            }
            activeLayerIds = newLayerIds;
        },
    );

    window.addEventListener(
        "locationChanged",
        (e: CustomEvent<LocationEventDetail>) => {
            const { lat, lng, zoom } = e.detail;
            map.flyTo({ center: [lng, lat], zoom: zoom, essential: true });
        },
    );
</script>
