---

---

<aside class="panel analysis-panel">
    <h2>Análisis de Accesibilidad</h2>

    <div id="analysis-content">
        <p><strong>Área Actual:</strong> <span id="lbl-area">Perú</span></p>
        <p class="text-muted" style="font-size: 0.85rem;">
            Selecciona un Centro Poblado en el mapa para analizar su acceso a
            servicios esenciales.
        </p>

        <hr class="panel-divider" />

        <div id="stats-container">
            <div style="text-align: center; padding: 2rem 0; color: #999;">
                <i>Esperando selección...</i>
            </div>
        </div>
    </div>
</aside>

<style>
    .carencia-alert {
        background-color: #ffeaa7;
        border-left: 4px solid #d35400;
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 4px;
    }
    .carencia-alert h4 {
        margin: 0 0 0.5rem 0;
        color: #d35400;
    }
    .carencia-alert p {
        margin: 0;
        font-size: 0.9rem;
        color: #555;
    }

    .service-card {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 0.75rem;
        border: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .service-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 1rem;
    }
    .service-info p {
        margin: 0;
        font-size: 0.8rem;
        color: #666;
    }
    .service-dist {
        font-size: 1.25rem;
        font-weight: bold;
    }
    .dist-good {
        color: #27ae60;
    }
    .dist-warn {
        color: #f39c12;
    }
    .dist-bad {
        color: #c0392b;
    }
</style>

<script>
    import type { LocationEventDetail, AccessibilityStats } from "../types";

    const lblArea = document.getElementById("lbl-area") as HTMLSpanElement;
    const statsContainer = document.getElementById(
        "stats-container",
    ) as HTMLDivElement;

    window.addEventListener(
        "locationChanged",
        (e: CustomEvent<LocationEventDetail>) => {
            lblArea.textContent = e.detail.name;
        },
    );

    window.addEventListener(
        "accessibilityCalculated",
        (e: CustomEvent<AccessibilityStats>) => {
            const data = e.detail;

            let html = `<h3 style="margin-top:0; color: var(--primary-color);">${data.centroPoblado}</h3>`;

            if (data.tripleCarencia) {
                html += `
          <div class="carencia-alert">
            <h4>⚠️ Zona de Triple Carencia</h4>
            <p>Este centro poblado se encuentra a más de 5km de distancia de salud, educación y seguridad.</p>
          </div>
        `;
            }

            const renderService = (
                title: string,
                serviceData: { distance: number; name: string } | null,
                color: string,
            ) => {
                if (!serviceData) {
                    return `
                    <div class="service-card">
                      <div class="service-info">
                        <h4 style="color: ${color}">${title}</h4>
                        <p>Capa no activa o sin datos</p>
                      </div>
                      <div class="service-dist text-muted">-- km</div>
                    </div>
                    `;
                }

                const dist = serviceData.distance;
                let distClass = "dist-good";
                if (dist > 2) distClass = "dist-warn";
                if (dist > 5) distClass = "dist-bad";

                return `
                <div class="service-card">
                  <div class="service-info">
                    <h4 style="color: ${color}">${title}</h4>
                    <p title="${serviceData.name}">${serviceData.name.length > 25 ? serviceData.name.substring(0, 25) + "..." : serviceData.name}</p>
                  </div>
                  <div class="service-dist ${distClass}">${dist.toFixed(1)} km</div>
                </div>
                `;
            };

            html += renderService("🏥 Salud", data.salud, "#e74c3c");
            html += renderService("🏫 Educación", data.educacion, "#3498db");
            html += renderService("👮 Comisaría", data.comisaria, "#2ecc71");

            // walking eta (5 km/h)
            if (data.salud || data.educacion || data.comisaria) {
                html += `<p class="text-muted" style="font-size:0.8rem; margin-top:1rem;">* Distancia en línea recta. Tiempo estimado a pie: ~12 min por km.</p>`;
            }

            statsContainer.innerHTML = html;
        },
    );
</script>
