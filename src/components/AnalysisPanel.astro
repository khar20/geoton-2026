<aside class="panel analysis-panel">
    <h2>Data Analysis</h2>

    <div id="analysis-content">
        <p>
            <strong>Location Level:</strong>
            <span id="lbl-level">National</span>
        </p>
        <p><strong>Current Area:</strong> <span id="lbl-area">Perú</span></p>

        <hr class="panel-divider" />

        <div id="stats-container">
            <p class="text-muted">Select a dataset to view analysis.</p>
        </div>
    </div>
</aside>

<script>
    import type {
        DatasetEventDetail,
        LocationEventDetail,
        ActiveDataset,
    } from "../types";

    const lblLevel = document.getElementById("lbl-level") as HTMLSpanElement;
    const lblArea = document.getElementById("lbl-area") as HTMLSpanElement;
    const statsContainer = document.getElementById(
        "stats-container",
    ) as HTMLDivElement;

    let currentLevel = "National";
    let currentArea = "Perú";
    let activeDatasets: ActiveDataset[] = [];

    window.addEventListener(
        "locationChanged",
        (e: CustomEvent<LocationEventDetail>) => {
            currentLevel = e.detail.level;
            currentArea = e.detail.name;
            lblLevel.textContent = currentLevel;
            lblArea.textContent = currentArea;
            fetchRealStats();
        },
    );

    window.addEventListener(
        "datasetChanged",
        (e: CustomEvent<DatasetEventDetail>) => {
            activeDatasets = e.detail.activeDatasets;
            fetchRealStats();
        },
    );

    async function fetchRealStats() {
        if (activeDatasets.length === 0) {
            statsContainer.innerHTML = `<p class="text-muted">Select a dataset to view analysis.</p>`;
            return;
        }

        statsContainer.innerHTML = `<p class="text-muted">Loading statistics for ${currentArea}...</p>`;

        try {
            const datasetIds = activeDatasets.map((d) => d.id).join(",");
            const url = `/api/stats?level=${encodeURIComponent(currentLevel)}&area=${encodeURIComponent(currentArea)}&datasets=${encodeURIComponent(datasetIds)}`;

            const response = await fetch(url);
            if (!response.ok) throw new Error("Network response was not ok");

            const data = await response.json();

            let html = "";
            data.stats.forEach((stat: any) => {
                const trendColor = stat.trend.startsWith("+") ? "green" : "red";
                html += `
                <div class="stat-card">
                    <h4>${stat.datasetName}</h4>
                    <div class="stat-value">${stat.value.toLocaleString()}</div>
                    <p>${stat.metric}</p>
                    <p style="color: ${trendColor};">Trend: <strong>${stat.trend}</strong></p>
                </div>
                `;
            });

            statsContainer.innerHTML = html;
        } catch (error) {
            console.error("Failed to fetch stats:", error);
            statsContainer.innerHTML = `<p class="text-error">Error loading statistics. Please try again.</p>`;
        }
    }
</script>
